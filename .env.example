# Where the SQLite file lives. Mount this folder as a volume in production.
DATABASE_PATH=./data/campqueue.db

# Staff sign-in. Change both before a real camp.
STAFF_PIN=1234
ADMIN_PIN=9999
# Long random string used to sign login cookies (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL, used for the QR code and SMS links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SMS provider: console (prints to the server log) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Prefix for 10-digit Indian numbers
SMS_DEFAULT_COUNTRY_CODE=+91
